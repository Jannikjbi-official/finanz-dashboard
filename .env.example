# ---- Server ----
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zufaelliger Wert, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ---- MongoDB ----
# Lokal ohne Installation: `npm run dev:db` startet eine MongoDB auf diesem Port
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finanz

# ---- Closed Beta ----
# Diese Adressen duerfen sich immer registrieren und anmelden (z. B. der Betreiber).
# Weitere Freischaltungen: npm run beta:invite -- adresse@example.org
ALLOWED_EMAILS=
# true = Registrierung fuer alle offen (Ende der Beta)
BETA_OPEN=false

# ---- Discord OAuth (optional) ----
# Redirect-URL im Discord Developer Portal:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Rechtliches (Impressum, Datenschutz) ----
# Ohne diese Angaben zeigen Impressum und Datenschutz einen Hinweis statt Daten.
LEGAL_NAME=
LEGAL_STREET=
LEGAL_CITY=
LEGAL_EMAIL=
# Erst auf true setzen, wenn die Texte rechtlich geprueft sind
LEGAL_REVIEWED=false
