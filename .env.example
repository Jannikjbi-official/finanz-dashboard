# ---- Server ----
# Adresse der Live-Seite. Optional auf Vercel: fehlt sie, wird die
# Produktionsdomain des Projekts verwendet. Auf Previews automatisch die
# Preview-Adresse (VERCEL_*-Variablen setzt Vercel selbst).
BETTER_AUTH_URL=http://localhost:3000
# Zufaelliger Wert, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ---- MongoDB ----
# Lokal ohne Installation: `npm run dev:db` startet eine MongoDB auf diesem Port
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finanz

# ---- Zugang ----
# Private Anwendung: NUR diese Adressen duerfen sich registrieren, anmelden und
# auf Daten zugreifen (kommagetrennt). Wird bei jeder Anfrage geprueft - eine
# entfernte Adresse verliert sofort den Zugriff. Leer = alles gesperrt.
ALLOWED_EMAILS=

# ---- Discord-Anmeldung (optional) ----
# Redirect-URL im Discord Developer Portal:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# ---- Better-Auth-Dashboard (optional) ----
# API-Key aus dash.better-auth.com. Ist er gesetzt, kann das Dashboard Nutzer
# und Sitzungen anzeigen und verwalten; Anmelde-Ereignisse gehen an Better Auth.
BETTER_AUTH_API_KEY=

# ---- Automatisches Buchen (optional) ----
# Geheimnis fuer den taeglichen Vercel Cron (/api/cron/recurring, siehe
# vercel.json). Vercel schickt es automatisch mit, wenn die Variable gesetzt
# ist. Ohne Wert ist der Endpunkt aus. Gebucht wird nur, was pro Abo bzw.
# fester Kosten mit "automatisch buchen" markiert ist.
CRON_SECRET=
