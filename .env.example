# ---- Server ----
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zufaelliger Wert, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ---- MongoDB ----
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finanz

# ---- Closed Beta ----
# Diese Adressen duerfen sich immer registrieren (z. B. der Betreiber).
# Weitere Einladungen: npm run beta:invite -- adresse@example.org
ALLOWED_EMAILS=
# true = Registrierung fuer alle offen
BETA_OPEN=false

# ---- Discord OAuth (optional) ----
# Redirect-URL im Discord Developer Portal:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
