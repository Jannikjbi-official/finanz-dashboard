# ── Datenbank (Neon Postgres) ───────────────────────────────────────────────
# Auf Vercel setzt die Neon-Integration DATABASE_URL automatisch.
# Lokal: eigene Postgres oder Neon-Branch, z. B.
DATABASE_URL=postgres://finanz:finanz@localhost:5432/finanz

# ── Login ───────────────────────────────────────────────────────────────────
# Zufälliger Wert mit mindestens 32 Zeichen: `openssl rand -base64 32`
AUTH_SECRET=
# Discord-Application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Deine Discord-User-ID (nur diese darf sich anmelden)
ALLOWED_DISCORD_ID=
# bcrypt-Hash des Notfall-Passworts: `npm run hash-password`
# In .env-Dateien jedes "$" als "\$" schreiben (auf Vercel NICHT escapen).
EMERGENCY_PASSWORD_HASH=

# Optional: öffentliche Adresse der App (lokal nicht nötig; auf Vercel wird
# automatisch die Produktionsdomain verwendet)
# BETTER_AUTH_URL=http://localhost:3000
