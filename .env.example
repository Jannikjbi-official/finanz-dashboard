# ---- Server ----
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Zufaelliger Wert, z. B. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# ---- MongoDB ----
# Lokal ohne Installation: `npm run dev:db` startet eine MongoDB auf diesem Port
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=finanz

# ---- Zugang ----
# Private Anwendung: nur diese Adressen duerfen sich registrieren und anmelden
# (kommagetrennt). Leer = niemand kann sich neu registrieren.
ALLOWED_EMAILS=

# ---- Discord-Anmeldung (optional) ----
# Redirect-URL im Discord Developer Portal:
# http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
